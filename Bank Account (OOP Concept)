class Bank {
    double balance = 1000;

    void deposit(double amt) {
        balance += amt;
    }

    void withdraw(double amt) {
        if (amt <= balance)
            balance -= amt;
        else
            System.out.println("Insufficient Balance");
    }

    void display() {
        System.out.println("Balance: " + balance);
    }
}

public class BankApp {
    public static void main(String[] args) {
        Bank b = new Bank();
        b.deposit(500);
        b.withdraw(300);
        b.display();
    }
}
