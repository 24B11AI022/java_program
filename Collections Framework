import java.util.*;

class Student {
    int id;
    String name;
    int marks;

    Student(int id, String name, int marks) {
        this.id = id;
        this.name = name;
        this.marks = marks;
    }
}

public class SortStudents {
    public static void main(String[] args) {
        ArrayList<Student> list = new ArrayList<>();

        list.add(new Student(1, "Ram", 80));
        list.add(new Student(2, "Shyam", 95));
        list.add(new Student(3, "Ravi", 70));

        list.sort((a, b) -> b.marks - a.marks);

        for (Student s : list) {
            System.out.println(s.name + " " + s.marks);
        }
    }
}
